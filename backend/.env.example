GROQ_API_KEY_PRIMARY=your_primary_groq_key_here
GROQ_API_KEY_UTILITY=your_utility_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3-32b
GROQ_UTILITY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PORT=3001
NODE_ENV=development

# --- Avatar generation (pick one provider) ---

# Option A: HuggingFace (free tier, recommended for testing)
# Get token at https://huggingface.co/settings/tokens
AVATAR_PROVIDER=huggingface
HF_TOKEN=token
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Option B: ModelsLab
# AVATAR_PROVIDER=modelslab
# MODELSLAB_KEY=your_modelslab_key_here

# Avatar quality settings (optional)
# AVATAR_STEPS=30
# AVATAR_GUIDANCE=7.5
# AVATAR_SIZE=512
